# Voice AI Configuration
VOICE_API_KEY=your_voice_api_key_here
COLLECTIONS_AGENT_ID=your_collections_agent_id_here
LEDGER_AGENT_ID=your_ledger_agent_id_here

# Authentication Secret for Webhook Custom Functions
LEDGER_SECRET=your_secure_ledger_secret_token

# Test Mode (When true, calls default test phone instead of customer phone & bypasses 9am-7pm IST hours check)
TEST_MODE=true

# Phone Numbers (E.164 format)
OWNER_PHONE=+918789536802
DEFAULT_CUSTOMER_PHONE=+916363077110
DEFAULT_SUPPLIER_PHONE=+916363077110

# SMTP Configuration for Payment Reminder Emails (Optional - fallback to polite dry-run if unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
FROM_EMAIL=accounts@vyapaarai.com
